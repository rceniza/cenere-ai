{"id": "foundations-beginner-eval", "track": "foundations", "level": "beginner", "prompt": "Explain a robust way to validate a unit-converter input and what to test.", "must_include_any": [["parse", "convert"], ["boundary", "range"], ["invalid", "nonnumeric"]], "must_not_include": ["ignore all errors", "always return zero"]}
{"id": "c-intermediate-eval", "track": "c", "level": "intermediate", "prompt": "Explain safe realloc handling for a C dynamic array, including failure.", "must_include_any": [["temporary", "temp"], ["realloc"], ["original pointer", "old pointer"], ["overflow", "size overflow"]], "must_not_include": ["overwrite the only pointer before checking", "free the original pointer on realloc failure"]}
{"id": "cpp-advanced-eval", "track": "cpp", "level": "advanced", "prompt": "Describe synchronization and shutdown for a bounded concurrent C++ queue.", "must_include_any": [["mutex"], ["condition variable", "condition_variable"], ["predicate", "while"], ["shutdown", "close"]], "must_not_include": ["volatile makes it thread-safe"]}
{"id": "csharp-beginner-eval", "track": "csharp", "level": "beginner", "prompt": "Show the principle for parsing user-provided integers safely in C#.", "must_include_any": [["TryParse", "tryparse"], ["range", "business rule"]], "must_not_include": ["parse and ignore exceptions"]}
{"id": "php-intermediate-eval", "track": "php", "level": "intermediate", "prompt": "Explain safe SQL writes in PHP with PDO.", "must_include_any": [["prepared", "prepare"], ["parameter", "bind"], ["concatenate", "allowlist"]], "must_not_include": ["concatenate user input into sql"]}
{"id": "javascript-typescript-intermediate-eval", "track": "javascript-typescript", "level": "intermediate", "prompt": "Explain how to model success and failure states with a TypeScript discriminated union.", "must_include_any": [["discriminated union", "union"], ["kind", "tag"], ["narrow", "narrowing"]], "must_not_include": ["use any as a shortcut"]}
{"id": "nodejs-beginner-eval", "track": "nodejs", "level": "beginner", "prompt": "List boundary checks for a Node.js JSON API request.", "must_include_any": [["content type", "content-type"], ["size", "body size"], ["validate", "validation"], ["400", "client error"]], "must_not_include": ["trust the body without validation"]}
{"id": "react-beginner-eval", "track": "react", "level": "beginner", "prompt": "Explain why React list keys need to be stable and when indexes are unsafe.", "must_include_any": [["stable", "persistent"], ["index", "array index"], ["reorder", "reordering"]], "must_not_include": ["random key"]}
{"id": "web-platform-beginner-eval", "track": "web-platform", "level": "beginner", "prompt": "Give three ways to make an HTML form usable with keyboard and screen readers.", "must_include_any": [["label"], ["focus", "keyboard"], ["semantic", "accessible name"]], "must_not_include": ["placeholder is the label"]}
{"id": "python-advanced-eval", "track": "python", "level": "advanced", "prompt": "Explain when asyncio helps and what to use for CPU-bound work.", "must_include_any": [["io", "i/o"], ["cpu-bound", "cpu bound"], ["process", "processes"]], "must_not_include": ["asyncio makes cpu work parallel"]}
{"id": "rust-beginner-eval", "track": "rust", "level": "beginner", "prompt": "How do you parse a Rust string as i64 and handle invalid input?", "must_include_any": [["parse::<i64>", "i64"], ["result", "error"]], "must_not_include": ["parse::<i32>"]}
{"id": "go-java-intermediate-eval", "track": "go-java", "level": "intermediate", "prompt": "Compare explicit error handling in Go and Java without discarding failures.", "must_include_any": [["go", "error"], ["java", "exception"], ["caller", "cause"]], "must_not_include": ["ignore the error"]}
{"id": "backend-api-intermediate-eval", "track": "backend-api", "level": "intermediate", "prompt": "Distinguish authentication from object-level authorization and say what to test.", "must_include_any": [["identity", "authentication"], ["authorization", "permission"], ["owner", "tenant"], ["cross", "wrong-owner"]], "must_not_include": ["login means all resources are accessible"]}
{"id": "sql-data-advanced-eval", "track": "sql-data", "level": "advanced", "prompt": "Explain when to add a database index and its tradeoff.", "must_include_any": [["query plan", "explain"], ["measure", "representative"], ["write", "storage"]], "must_not_include": ["index every column"]}
{"id": "git-linux-shell-intermediate-eval", "track": "git-linux-shell", "level": "intermediate", "prompt": "How do you make a Bash pipeline fail when an earlier command fails?", "must_include_any": [["pipefail", "set -o pipefail"], ["exit status", "status"]], "must_not_include": ["set -e always catches every pipeline failure"]}
{"id": "docker-advanced-eval", "track": "docker", "level": "advanced", "prompt": "Name production Docker image hardening steps and how to verify them.", "must_include_any": [["non-root", "nonroot"], ["secrets", "secret"], ["digest", "pinned"], ["read-only", "read only"]], "must_not_include": ["put secrets in the image"]}
{"id": "cicd-advanced-eval", "track": "cicd", "level": "advanced", "prompt": "Explain how to make a release traceable and rollbackable.", "must_include_any": [["commit", "revision"], ["digest", "immutable"], ["rollback", "known-good"]], "must_not_include": ["rebuild a different artifact during rollback"]}
{"id": "kubernetes-intermediate-eval", "track": "kubernetes", "level": "intermediate", "prompt": "Distinguish readiness and liveness probes and one failure mode to avoid.", "must_include_any": [["traffic", "readiness"], ["restart", "liveness"], ["dependency", "restart loop"]], "must_not_include": ["use liveness to restart on every dependency outage"]}
{"id": "kafka-redpanda-advanced-eval", "track": "kafka-redpanda", "level": "advanced", "prompt": "Explain safe offset commits when a consumer writes to an external database.", "must_include_any": [["idempotent", "idempotency"], ["durable", "write"], ["offset", "commit"]], "must_not_include": ["commit before the side effect without replay handling"]}
{"id": "caching-advanced-eval", "track": "caching", "level": "advanced", "prompt": "Describe how to handle Redis outage without overwhelming the source database.", "must_include_any": [["bounded", "limit"], ["backoff", "circuit"], ["fallback", "fail open", "fail closed"]], "must_not_include": ["retry immediately forever"]}
{"id": "observability-sre-intermediate-eval", "track": "observability-sre", "level": "intermediate", "prompt": "Explain how metrics and traces complement each other and mention cardinality.", "must_include_any": [["metric", "metrics"], ["trace", "traces"], ["cardinality", "high-cardinality"]], "must_not_include": ["put user IDs in every metric label"]}
{"id": "security-advanced-eval", "track": "security", "level": "advanced", "prompt": "List key elements of a threat model for a web service.", "must_include_any": [["asset", "assets"], ["trust boundary", "entry point"], ["abuse", "threat"], ["mitigation", "risk"]], "must_not_include": ["only list vulnerabilities after launch"]}
{"id": "cloud-production-intermediate-eval", "track": "cloud-production", "level": "intermediate", "prompt": "Explain how to plan rollback when a deployment includes a database schema change.", "must_include_any": [["backward compatible", "expand"], ["rollback", "known-good"], ["migration", "schema"]], "must_not_include": ["assume database changes always roll back with code"]}
{"id": "ai-model-ops-advanced-eval", "track": "ai-model-ops", "level": "advanced", "prompt": "How should a low-resource LoRA candidate be evaluated before serving it?", "must_include_any": [["held-out", "evaluation set"], ["base model", "baseline"], ["regression", "correctness"], ["memory", "pressure"]], "must_not_include": ["promote based only on training loss"]}
{"id": "multimodal-beginner-eval", "track": "multimodal", "level": "beginner", "prompt": "Can the installed text-only Qwen2.5-Coder inspect an image or video? Explain the missing components.", "must_include_any": [["text-only", "qwen2forcausallm"], ["vision", "vision-language"], ["processor", "image payload"], ["video", "frames"]], "must_not_include": ["yes, because OCR is automatic"]}
